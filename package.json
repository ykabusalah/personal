{
  "name": "personal",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check-dist": "node scripts/check-dist.mjs",
    "deploy": "astro build && node scripts/check-dist.mjs && node scripts/vercel-output.mjs && npx --yes vercel deploy --prebuilt --prod",
    "deploy:preview": "astro build && node scripts/check-dist.mjs && node scripts/vercel-output.mjs && npx --yes vercel deploy --prebuilt",
    "ship": "node scripts/ship.mjs",
    "studio": "node scripts/studio.mjs serve",
    "studio:deploy": "node scripts/studio.mjs build && cd studio && npx --yes vercel deploy --prebuilt --prod",
    "doodles:pull": "node scripts/pull-doodles.mjs",
    "doodles:mock": "node scripts/mock-doodles.mjs",
    "doodles:unmock": "node scripts/mock-doodles.mjs --remove"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@supabase/supabase-js": "^2.117.0",
    "astro": "^7.3.3",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "potrace": "^2.1.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19"
  }
}
