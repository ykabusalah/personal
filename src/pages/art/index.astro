---
import PageLayout from '../../layouts/PageLayout.astro';
import Doodle from '../../components/Doodle.astro';
import { getSection, KIND_HEADING, KIND_ORDER } from '../../lib/work';

// Creative work: an image-led gallery rather than a list.
const pieces = await getSection('art');
const groups = KIND_ORDER.map((kind) => ({
  kind,
  entries: pieces.filter((entry) => entry.data.kind === kind),
})).filter((group) => group.entries.length > 0);
---

<PageLayout title="Art | Yousef's Personal Website" page="art">
  <h1 class="page-title"><span class="mark">Art</span></h1>

  {groups.map(({ kind, entries }, i) => (
    <section class="group">
      {i === 0 && <Doodle side="left" top="10px" tilt={-7} name="art-side-1" note="a paintbrush, sketchbook, or ink pot" width={104} />}
      {i === 0 && <Doodle side="right" top="50%" tilt={6} mobile="inline" name="art-side-2" note="a character from one of the books" width={104} />}
      <h2 class="eyebrow">{KIND_HEADING[kind]}</h2>
      <ul class="tiles">
        {entries.map((entry) => (
          <li>
            <a class="tile" href={`/art/${entry.id}`}>
              <span class="cover"><Doodle kind="image" name={`art-${entry.id}`} note="a page or spread from the book" width={320} aspect="4 / 5" /></span>
              <span class="title">{entry.data.title}</span>
              {entry.data.draft && <span class="badge">Draft</span>}
              <span class="summary">{entry.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</PageLayout>

<style>
  .group {
    position: relative;
    margin-top: 40px;
  }

  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 24px;
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
  }

  .cover:not(:empty) {
    display: block;
    margin-bottom: 8px;
    border-radius: 6px;
    overflow: hidden;
  }

  .cover :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .cover :global(.slot) { width: 100%; }

  .title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 30px;
    line-height: 1.05;
  }

  .tile:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  .summary {
    font-size: 14px;
    color: var(--muted);
  }

  .badge {
    align-self: flex-start;
    font-size: 12px;
    padding: 2px 10px;
    border-radius: 999px;
    background: #f1efe9;
    color: var(--muted);
  }

  @media (max-width: 520px) {
    .tiles { grid-template-columns: minmax(0, 1fr); }
  }
</style>
