---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import '../../styles/prose.css';
import PageLayout from '../../layouts/PageLayout.astro';
import Doodle from '../../components/Doodle.astro';
import KeeganNote from '../../components/KeeganNote.astro';
import { ART_MAX_WIDTH, ART_WIDTHS, coverFor, pagesFor } from '../../lib/art';
import { getSection, KIND_LABEL, type WorkEntry } from '../../lib/work';

export async function getStaticPaths() {
  const pieces = await getSection('art');
  return pieces.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: WorkEntry };
const { data } = entry;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());

// A comic shows its pages in order, so it skips the separate cover (usually one of those pages).
const pages = await pagesFor(entry.id);
const cover = pages.length ? undefined : await coverFor(entry.id);
---

<PageLayout title={`${data.title} | Yousef's Personal Website`} description={data.summary} page={`art/${entry.id}`}>
  <a class="back" href="/art">← All art</a>

  <p class="eyebrow">{data.kind === 'fellowship' ? <KeeganNote label={KIND_LABEL[data.kind]} /> : KIND_LABEL[data.kind]}{data.draft && ' · Draft'}</p>
  <h1 class="page-title"><span class="mark">{data.title}</span></h1>
  <p class="summary">{data.summary}</p>
  {data.live && (
    <a class="read-more" href={data.live} target={data.live.startsWith('http') ? '_blank' : undefined} rel="noopener">
      Read it on {data.live.includes('substack.com') ? 'Substack' : 'the web'} →
    </a>
  )}

  {!pages.length && (
    <div class="cover">{cover
      ? <Image class="art-image" src={cover} alt={data.coverAlt} width={Math.min(ART_MAX_WIDTH, cover.width)} widths={ART_WIDTHS} sizes="(min-width: 720px) 680px, 100vw" loading="eager" draggable="false" />
      : <Doodle kind="image" name={`art-${entry.id}`} note={`${entry.id}/cover.jpg in src/art`} width={680} aspect="4 / 3" />}</div>
  )}

  {hasBody && (
    <div class="body">
      <Doodle side="right" top="20px" tilt={5} name={`art-${entry.id}-side`} note="a sketch from this piece" width={104} />
      <article class="prose">
        <Content />
      </article>
    </div>
  )}

  {pages.length > 0 && (
    <section class="pages" aria-labelledby="read-it">
      <h2 id="read-it" class="section-title">Read it</h2>
      {pages.map((page, i) => (
        <Image
          class="art-image page"
          src={page}
          alt={data.pageAlts[i] ?? `Page ${i + 1}`}
          width={Math.min(ART_MAX_WIDTH, page.width)}
          widths={ART_WIDTHS}
          sizes="(min-width: 720px) 680px, 100vw"
          loading={i < 2 ? 'eager' : 'lazy'}
          draggable="false"
        />
      ))}
    </section>
  )}
</PageLayout>

<style>
  .back {
    display: inline-block;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 28px;
  }

  .back:hover { color: var(--ink); }

  .page-title { font-style: italic; }

  .summary {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.35;
    margin: 0 0 28px;
  }

  .read-more {
    display: inline-block;
    margin: -12px 0 28px;
    font-weight: 500;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /* The cover is a print taped into the sketchbook, like the tiles on the Art page. */
  .cover:not(:empty) {
    position: relative;
    margin: 8px 0;
    padding: 10px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08), 0 14px 30px -18px rgba(0, 0, 0, 0.35);
    transform: rotate(-0.8deg);
  }

  .cover:not(:empty)::before,
  .cover:not(:empty)::after {
    content: '';
    position: absolute;
    z-index: 1;
    top: -2px;
    width: 88px;
    height: 24px;
    background: color-mix(in srgb, var(--accent) 42%, transparent);
    mix-blend-mode: multiply;
    clip-path: polygon(0 12%, 5% 0, 50% 6%, 95% 0, 100% 14%, 97% 50%, 100% 88%, 94% 100%, 50% 94%, 6% 100%, 0 86%, 3% 50%);
  }

  /* On a dark page, multiply would make the tape vanish off the edge of the print. */
  @media (prefers-color-scheme: dark) {
    .cover:not(:empty)::before,
    .cover:not(:empty)::after {
      background: color-mix(in srgb, var(--accent) 70%, transparent);
      mix-blend-mode: normal;
    }
  }

  .cover:not(:empty)::before { left: -26px; transform: rotate(-36deg); }
  .cover:not(:empty)::after { right: -26px; transform: rotate(36deg); }

  .cover :global(img),
  .cover :global(.slot) { display: block; width: 100%; height: auto; }

  .body {
    position: relative;
    margin-top: 44px;
  }

  .pages { margin-top: 44px; }

  .pages :global(.page) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 0 28px;
    border: 1px solid var(--line);
  }
</style>
