---
import { render } from 'astro:content';
import '../../styles/prose.css';
import PageLayout from '../../layouts/PageLayout.astro';
import Doodle from '../../components/Doodle.astro';
import { getSection, KIND_LABEL, type WorkEntry } from '../../lib/work';

export async function getStaticPaths() {
  const pieces = await getSection('art');
  return pieces.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: WorkEntry };
const { data } = entry;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
---

<PageLayout title={`${data.title} | Yousef's Personal Website`} description={data.summary} page={`art/${entry.id}`}>
  <a class="back" href="/art">← All art</a>

  <p class="eyebrow">{KIND_LABEL[data.kind]}{data.draft && ' · Draft'}</p>
  <h1 class="page-title"><span class="mark">{data.title}</span></h1>
  <p class="summary">{data.summary}</p>
  {data.live && (
    <a class="read-more" href={data.live} target={data.live.startsWith('http') ? '_blank' : undefined} rel="noopener">
      Read it on {data.live.includes('substack.com') ? 'Substack' : 'the web'} →
    </a>
  )}

  <div class="cover"><Doodle kind="image" name={`art-${entry.id}`} note="a page or spread from the book" width={680} aspect="4 / 3" /></div>

  {hasBody && (
    <div class="body">
      <Doodle side="right" top="20px" tilt={5} name={`art-${entry.id}-side`} note="a sketch from this piece" width={104} />
      <article class="prose">
        <Content />
      </article>
    </div>
  )}
</PageLayout>

<style>
  .back {
    display: inline-block;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 28px;
  }

  .back:hover { color: var(--ink); }

  .page-title { font-style: italic; }

  .summary {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.35;
    margin: 0 0 28px;
  }

  .read-more {
    display: inline-block;
    margin: -12px 0 28px;
    font-weight: 500;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .cover:not(:empty) {
    border-radius: 8px;
    overflow: hidden;
  }

  .cover :global(img) { width: 100%; height: auto; }

  .body {
    position: relative;
    margin-top: 44px;
  }
</style>
