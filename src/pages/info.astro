---
import PageLayout from '../layouts/PageLayout.astro';
import Doodle from '../components/Doodle.astro';
import { getApprovedCount } from '../lib/drawings-build.js';

// Plain HTML like the other pages, so it shows right away instead of waiting on React.
const count = await getApprovedCount();

// Doodles scattered through the white space on both sides, to give the page some life before people draw.
// lane: 0 hugs the screen edge, 1 sits just outside the text. top is from the top of the intro.
const SPOTS = [
  { name: 'draw-1', note: 'a pencil with a face', side: 'l', lane: 0.15, top: 40, tilt: -8, phone: true },
  { name: 'draw-2', note: 'a paint splatter or scribble', side: 'l', lane: 0.8, top: 190, tilt: 6 },
  { name: 'draw-3', note: 'an arrow pointing at Let\'s Draw!', side: 'l', lane: 0.9, top: 350, tilt: -3, phone: true },
  { name: 'draw-4', note: 'a crayon or marker', side: 'l', lane: 0.2, top: 520, tilt: 9 },
  { name: 'draw-5', note: 'stars or sparkles', side: 'r', lane: 0.3, top: -10, tilt: 7 },
  { name: 'draw-6', note: 'you, mid-sketch', side: 'r', lane: 0.85, top: 170, tilt: -6, phone: true },
  { name: 'draw-7', note: 'a little creature peeking in', side: 'r', lane: 0.15, top: 360, tilt: 4 },
  { name: 'draw-8', note: 'an eraser and some smudges', side: 'r', lane: 0.7, top: 530, tilt: -7 },
];
---

<PageLayout
  title="Draw something | Yousef's Personal Website"
  description="Draw something, and it could become part of my website's design."
  page="info"
>
  <section class="intro">
    <div class="spots" aria-hidden="true">
      {SPOTS.map((s) => (
        <span class:list={['spot', s.side, s.phone && 'phone']} style={`--lane:${s.lane};--top:${s.top}px;--tilt:${s.tilt}deg`}><Doodle name={s.name} note={s.note} width={96} /></span>
      ))}
    </div>
    <p class="eyebrow">Interactive experience</p>
    <h1 class="page-title"><span class="mark">Hello and Welcome</span> 👋🏽</h1>
    <p class="lede">
      The basic idea is that your drawing can become part of my website's design. Approved drawings are displayed at random whenever anyone visits the site. However, if your drawing is ugly, it ain't getting chosen. Good luck :)
    </p>
    <p class="count" data-count-line hidden={!count}>
      <span class="dot" aria-hidden="true"></span>
      <span><span data-drawing-count>{count}</span> drawings featured so far</span>
    </p>
    <a class="button" href="/draw">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 20h9" />
        <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4Z" />
      </svg>
      Let's Draw!
    </a>
  </section>
</PageLayout>

<script>
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  // The count above is from the last build; swap in the live number.
  fetch(`${SUPABASE_URL}/rest/v1/drawings?select=id&status=eq.approved`, {
    method: 'HEAD',
    headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}`, Prefer: 'count=exact' },
  })
    .then((res) => {
      const total = Number(res.headers.get('content-range')?.split('/')[1]);
      if (!total) return;
      document.querySelector('[data-drawing-count]')!.textContent = String(total);
      document.querySelector<HTMLElement>('[data-count-line]')!.hidden = false;
    })
    .catch(() => {});

  // Start loading the canvas in the background so it opens quickly after "Let's Draw!".
  const warmCanvas = () => import('../islands/DrawCanvas.jsx').catch(() => {});
  if ('requestIdleCallback' in window) requestIdleCallback(warmCanvas);
  else setTimeout(warmCanvas, 1500);
</script>

<style>
  .intro {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .intro > :not(.spots) { max-width: 100%; }

  /* Phones and narrow windows: three doodles in a row under the button. */
  .spots {
    order: 10;
    display: flex;
    gap: 20px;
  }

  .spot { display: none; transform: rotate(var(--tilt)); }
  .spot.phone { display: block; transform: rotate(var(--tilt)) scale(0.8); }

  /* Spots with no drawing yet are empty, so they take no room. */
  .spot.phone:not(:empty) { margin-top: 32px; }

  /* Wide screens: spread through the white space beside the text.
     50% - 50vw is the screen edge; --room is the white space on each side, less a doodle and a gap. */
  @media (min-width: 1100px) {
    .spots {
      --room: calc((100vw - 680px) / 2 - 164px);
      display: contents;
    }

    .spot,
    .spot.phone,
    .spot.phone:not(:empty) {
      display: block;
      position: absolute;
      top: var(--top);
      margin: 0;
      transform: rotate(var(--tilt));
    }

    .spot.l { left: calc(50% - 50vw + 24px + var(--room) * var(--lane)); }
    .spot.r { right: calc(50% - 50vw + 24px + var(--room) * var(--lane)); }
  }

  .page-title { margin-bottom: 24px; }

  .lede {
    max-width: 56ch;
    margin: 0 0 24px;
    font-size: 19px;
    line-height: 1.55;
  }

  .count {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 28px;
    font-size: 14px;
    color: var(--muted);
  }

  .count[hidden] { display: none; }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
