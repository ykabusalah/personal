---
import PageLayout from '../layouts/PageLayout.astro';
import Doodle from '../components/Doodle.astro';
import { getApprovedCount } from '../lib/drawings-build.js';
import { approvalRate, fetchDrawingTotals, formatCount } from '../lib/drawing-totals';
import { spotsFor } from '../data/doodle-spots.js';

// Plain HTML like the other pages, so it shows right away instead of waiting on React.
// The full tally needs the drawing_stats function; without it, fall back to just the featured count.
const totals = await fetchDrawingTotals();
const count = totals ? totals.approved : await getApprovedCount();

// Doodles scattered through the white space on both sides, to give the page some life before people draw.
// Spots 14a to 14h in src/data/doodle-spots.js, in this order.
// lane: 0 hugs the screen edge, 1 sits just outside the text. top is from the top of the intro.
const LAYOUT = [
  { side: 'l', lane: 0.15, top: 40, tilt: -8, phone: true },
  { side: 'l', lane: 0.8, top: 190, tilt: 6 },
  { side: 'l', lane: 0.9, top: 350, tilt: -3, phone: true },
  { side: 'l', lane: 0.2, top: 520, tilt: 9 },
  { side: 'r', lane: 0.3, top: -10, tilt: 7 },
  { side: 'r', lane: 0.85, top: 170, tilt: -6, phone: true },
  { side: 'r', lane: 0.15, top: 360, tilt: 4 },
  { side: 'r', lane: 0.7, top: 530, tilt: -7 },
];
const SPOTS = spotsFor('info').map((spot, i) => ({ ...spot, ...LAYOUT[i] }));
---

<PageLayout
  title="Draw something | Yousef's Personal Website"
  description="Draw something, and it could become part of my website's design."
  page="info"
>
  <section class="intro">
    <div class="spots" aria-hidden="true">
      {SPOTS.map((s) => (
        <span class:list={['spot', s.side, s.phone && 'phone']} style={`--lane:${s.lane};--top:${s.top}px;--tilt:${s.tilt}deg`}><Doodle spot={s.id} /></span>
      ))}
    </div>
    <p class="eyebrow">Interactive experience</p>
    <h1 class="page-title"><span class="mark">Hello and Welcome</span> 👋🏽</h1>
    <p class="lede">
      The basic idea is that your drawing can become part of my website's design. Approved drawings are displayed at random whenever anyone visits the site. However, if your drawing is ugly, it ain't getting chosen. Good luck :)
    </p>
    {totals ? (
      <div class="tally" data-tally>
        <dl class="numbers">
          <div><dt>drawings submitted</dt><dd data-stat="submitted">{formatCount(totals.submitted)}</dd></div>
          <div><dt>made the cut</dt><dd data-stat="approved">{formatCount(totals.approved)}</dd></div>
          <div><dt>approval rate</dt><dd data-stat="rate">{approvalRate(totals)}%</dd></div>
        </dl>
        <p class="picky">
          <svg viewBox="0 0 40 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M38 18 C28 22, 16 16, 4 5" />
            <path d="M4 5 L12 6 M4 5 L6 13" />
          </svg>
          yes, I'm picky
        </p>
      </div>
    ) : (
      <p class="count" hidden={!count}>
        <span class="dot" aria-hidden="true"></span>
        <span>{count} drawings featured so far</span>
      </p>
    )}
    <a class="button" href="/draw">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 20h9" />
        <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4Z" />
      </svg>
      Let's Draw!
    </a>
  </section>
</PageLayout>

<script>
  import { approvalRate, formatCount, setCount, watchDrawingTotals } from '../lib/drawing-totals';

  // The numbers above are from the last build; swap in today's, and keep them current while the
  // page is open.
  const tally = document.querySelector('[data-tally]');
  if (tally) {
    watchDrawingTotals((t, first) => {
      const set = (key: string, value: string) => setCount(tally.querySelector(`[data-stat="${key}"]`), value, !first);
      set('submitted', formatCount(t.submitted));
      set('approved', formatCount(t.approved));
      set('rate', `${approvalRate(t)}%`);
    });
  }

  // Start loading the canvas in the background so it opens quickly after "Let's Draw!".
  const warmCanvas = () => import('../islands/DrawCanvas.jsx').catch(() => {});
  if ('requestIdleCallback' in window) requestIdleCallback(warmCanvas);
  else setTimeout(warmCanvas, 1500);
</script>

<style>
  .intro {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .intro > :not(.spots) { max-width: 100%; }

  /* Phones and narrow windows: three doodles in a row under the button. */
  .spots {
    order: 10;
    display: flex;
    gap: 20px;
  }

  .spot { display: none; transform: rotate(var(--tilt)); }
  .spot.phone { display: block; transform: rotate(var(--tilt)) scale(0.8); }

  /* Spots with no drawing yet are empty, so they take no room. */
  .spot.phone:not(:empty) { margin-top: 32px; }

  /* Wide screens: spread through the white space beside the text.
     50% - 50vw is the screen edge; --room is the white space on each side, less a doodle and a gap. */
  @media (min-width: 1100px) {
    .spots {
      --room: calc((100vw - 680px) / 2 - 164px);
      display: contents;
    }

    .spot,
    .spot.phone,
    .spot.phone:not(:empty) {
      display: block;
      position: absolute;
      top: var(--top);
      margin: 0;
      transform: rotate(var(--tilt));
    }

    .spot.l { left: calc(50% - 50vw + 24px + var(--room) * var(--lane)); }
    .spot.r { right: calc(50% - 50vw + 24px + var(--room) * var(--lane)); }
  }

  .page-title { margin-bottom: 24px; }

  .lede {
    max-width: 56ch;
    margin: 0 0 24px;
    font-size: 19px;
    line-height: 1.55;
  }

  /* The tally: three big numbers, with a handwritten aside pointing back at the approval rate. */
  .tally {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 6px 14px;
    margin: 0 0 28px;
  }

  .numbers {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 36px;
    margin: 0;
  }

  .numbers dt {
    margin-bottom: 4px;
    font-size: 13px;
    color: var(--muted);
  }

  .numbers dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 40px;
    line-height: 1;
  }

  .picky {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 4px;
    font-family: var(--font-hand);
    font-size: 24px;
    line-height: 1;
    color: var(--accent-ink);
    transform: rotate(-3deg);
  }

  .picky svg {
    width: 30px;
    height: 18px;
    flex: none;
  }

  .count {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 28px;
    font-size: 14px;
    color: var(--muted);
  }

  .count[hidden] { display: none; }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
