---
import PageLayout from '../layouts/PageLayout.astro';
import Doodle from '../components/Doodle.astro';
import { getApprovedCount } from '../lib/drawings-build.js';

// Plain HTML like the other pages, so it shows right away instead of waiting on React.
const count = await getApprovedCount();
---

<PageLayout
  title="Draw something | Yousef's Personal Website"
  description="Draw something, and it could become part of my website's design."
  page="info"
>
  <section class="intro">
    <Doodle side="right" top="20px" tilt={6} mobile="inline" name="draw-intro" note="a pencil character, or you mid-sketch" width={120} />
    <p class="eyebrow">Interactive experience</p>
    <h1 class="page-title"><span class="mark">Hello and Welcome</span> 👋🏽</h1>
    <p class="lede">
      The basic idea is that your drawing can become part of my website's design. Approved drawings are displayed at random whenever anyone visits the site. However, if your drawing is ugly, it ain't getting chosen. Good luck :)
    </p>
    <p class="count" data-count-line hidden={!count}>
      <span class="dot" aria-hidden="true"></span>
      <span><span data-drawing-count>{count}</span> drawings featured so far</span>
    </p>
    <a class="button" href="/draw">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 20h9" />
        <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4Z" />
      </svg>
      Let's Draw!
    </a>
  </section>
</PageLayout>

<script>
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  // The count above is from the last build; swap in the live number.
  fetch(`${SUPABASE_URL}/rest/v1/drawings?select=id&status=eq.approved`, {
    method: 'HEAD',
    headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}`, Prefer: 'count=exact' },
  })
    .then((res) => {
      const total = Number(res.headers.get('content-range')?.split('/')[1]);
      if (!total) return;
      document.querySelector('[data-drawing-count]')!.textContent = String(total);
      document.querySelector<HTMLElement>('[data-count-line]')!.hidden = false;
    })
    .catch(() => {});

  // Start loading the canvas in the background so it opens quickly after "Let's Draw!".
  const warmCanvas = () => import('../islands/DrawCanvas.jsx').catch(() => {});
  if ('requestIdleCallback' in window) requestIdleCallback(warmCanvas);
  else setTimeout(warmCanvas, 1500);
</script>

<style>
  .intro { position: relative; }

  .page-title { margin-bottom: 24px; }

  .lede {
    max-width: 56ch;
    margin: 0 0 24px;
    font-size: 19px;
    line-height: 1.55;
  }

  .count {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 28px;
    font-size: 14px;
    color: var(--muted);
  }

  .count[hidden] { display: none; }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
