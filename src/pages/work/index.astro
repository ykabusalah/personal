---
import PageLayout from '../../layouts/PageLayout.astro';
import Doodle from '../../components/Doodle.astro';
import { getWork, KIND_HEADING, KIND_ORDER } from '../../lib/work';

const work = await getWork();
const groups = KIND_ORDER.map((kind) => ({
  kind,
  entries: work.filter((entry) => entry.data.kind === kind),
})).filter((group) => group.entries.length > 0);
---

<PageLayout title="Work | Yousef's Personal Website" page="work">
  <div class="title-row">
    <h1 class="page-title"><span class="mark">Work</span></h1>
    <Doodle name="work-title" note="a stack of sketchbooks or a pencil" width={72} />
  </div>

  {groups.map(({ kind, entries }) => (
    <section class="group">
      <h2 class="eyebrow">{KIND_HEADING[kind]}</h2>
      <ul class="rows">
        {entries.map((entry) => (
          <li>
            <a class:list={['row', kind]} href={`/work/${entry.id}`}>
              <span class="thumb"><Doodle kind="image" name={`work-${entry.id}`} note="screenshot, or a page from the book" width={132} /></span>
              <span class="text">
                <span class="title-line">
                  <span class="title">{entry.data.title}</span>
                  {entry.data.draft && <span class="badge">Draft</span>}
                  {!entry.data.draft && entry.data.status === 'in-progress' && <span class="badge">In progress</span>}
                </span>
                <span class="summary">{entry.data.summary}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <div class="end">
    <Doodle name="work-end" note="a 'more soon' doodle" width={96} />
  </div>
</PageLayout>

<style>
  .title-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .title-row .page-title { margin: 0; }

  .group { margin-top: 40px; }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .row {
    display: flex;
    align-items: flex-start;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  /* Pieces with an image get a thumbnail column; pieces without one keep the full width. */
  .thumb:not(:empty) {
    flex: none;
    width: 132px;
    margin-right: 18px;
    border-radius: 8px;
    overflow: hidden;
  }

  .thumb :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .title-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .title {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1.1;
  }

  .fellowship .title { font-style: italic; }

  .row:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  .summary {
    font-size: 15px;
    color: var(--muted);
    max-width: 60ch;
  }

  .badge {
    flex: none;
    font-size: 12px;
    padding: 3px 10px;
    border-radius: 999px;
    background: #f1efe9;
    color: var(--muted);
  }

  .end {
    display: flex;
    justify-content: center;
    margin-top: 56px;
  }

  @media (max-width: 520px) {
    .thumb:not(:empty) { width: 96px; margin-right: 14px; }
    .title { font-size: 24px; }
  }
</style>
