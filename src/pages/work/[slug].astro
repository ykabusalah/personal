---
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Doodle from '../../components/Doodle.astro';
import { getWork, KIND_LABEL, type WorkEntry } from '../../lib/work';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: WorkEntry };
const { data } = entry;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());

const links = [
  data.live && { label: data.live.startsWith('/') ? 'Try it' : 'Live site', href: data.live },
  data.github && { label: 'GitHub', href: data.github },
].filter(Boolean) as { label: string; href: string }[];
---

<PageLayout title={`${data.title} | Yousef's Personal Website`} description={data.summary} page={`work/${entry.id}`}>
  <a class="back" href="/work">← All work</a>

  <p class="eyebrow">
    {KIND_LABEL[data.kind]}{data.status === 'in-progress' && ' · In progress'}{data.draft && ' · Draft'}
  </p>
  <h1 class:list={['page-title', { italic: data.kind === 'fellowship' }]}><span class="mark">{data.title}</span></h1>
  <p class="summary">{data.summary}</p>

  {links.length > 0 && (
    <ul class="chips links">
      {links.map(({ label, href }) => (
        <li><a class="chip" href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener">{label}</a></li>
      ))}
    </ul>
  )}

  {data.stack.length > 0 && (
    <ul class="chips stack" aria-label="Built with">
      {data.stack.map((item) => <li><span class="chip">{item}</span></li>)}
    </ul>
  )}

  <div class="hero-image"><Doodle kind="image" name={`work-${entry.id}`} note="a screenshot for projects, or a page from the book" width={680} /></div>

  {hasBody && (
    <>
      <div class="divider"><Doodle name="divider" note="a hand-drawn squiggle line" width={220} aspect="6 / 1" /></div>
      <article class="prose">
        <Content />
      </article>
    </>
  )}
</PageLayout>

<style>
  .back {
    display: inline-block;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 28px;
  }

  .back:hover { color: var(--ink); }

  .italic { font-style: italic; }

  .summary {
    font-size: 19px;
    line-height: 1.55;
    margin: 0 0 24px;
  }

  .links { margin-bottom: 12px; }

  .stack .chip {
    font-size: 12px;
    color: var(--muted);
    background: #f7f6f2;
    border-color: transparent;
  }

  .hero-image:not(:empty) {
    margin-top: 32px;
    border-radius: 12px;
    overflow: hidden;
  }

  .hero-image :global(img) { width: 100%; height: auto; }

  .divider:not(:empty) {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  /* With a drawn divider in place, the plain rule above the PRD steps aside. */
  .divider:not(:empty) + .prose { border-top: 0; margin-top: 24px; }

  .prose {
    margin-top: 48px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
    font-size: 16px;
    line-height: 1.7;
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.15;
    margin: 40px 0 12px;
  }

  .prose :global(h3) {
    font-size: 17px;
    font-weight: 600;
    margin: 28px 0 8px;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 16px; }

  .prose :global(li) { margin-bottom: 6px; }

  .prose :global(strong) { font-weight: 600; }

  .prose :global(code) {
    font-size: 0.9em;
    padding: 1px 5px;
    border-radius: 4px;
    background: #f3f1ec;
  }

  /* Wide tables scroll inside themselves instead of widening the page. */
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 0 0 20px;
    font-size: 14px;
    line-height: 1.5;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 10px 14px 10px 0;
    border-bottom: 1px solid var(--line);
  }

  .prose :global(th) { font-weight: 600; }
</style>
