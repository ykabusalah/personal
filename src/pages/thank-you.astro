---
import PageLayout from '../layouts/PageLayout.astro';
import Doodle from '../components/Doodle.astro';
---

<PageLayout title="Thank you | Yousef's Personal Website" page="thank_you">
  <section class="thanks">
    <Doodle side="right" top="20px" tilt={-5} mobile="inline" name="thank-you" note="a celebrating character" width={120} />
    <h1 class="page-title">🎉 <span class="mark">Thank You!</span></h1>
    <p class="lede">
      Your drawing was submitted successfully. If it's selected, it will appear on the main site with your name at the bottom right. Thanks for contributing!
    </p>
    <a class="button" href="/">Return to Home</a>
  </section>
</PageLayout>

<style>
  .thanks { position: relative; }

  .page-title { margin-bottom: 24px; }

  .lede {
    max-width: 52ch;
    margin: 0 0 28px;
    font-size: 19px;
    line-height: 1.55;
  }
</style>
