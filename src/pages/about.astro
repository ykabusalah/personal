---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import { getSection, getWork, hrefFor, KIND_LABEL, SECTIONS } from '../lib/work';
import portrait from '../assets/portrait/portrait.png';
import patchMask from '../assets/portrait/patch-mask.png';
import doodles from '../data/portrait-doodles.json';
import Doodle from '../components/Doodle.astro';

// Yousef's doodles from Portrait Studio: smooth each stroke and time its draw-on by its length.
type Point = [number, number];
const toPath = (pts: Point[]) => {
  if (pts.length === 1) return `M${pts[0][0]} ${pts[0][1]}l0.01 0`;
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const [x, y] = pts[i], [nx, ny] = pts[i + 1];
    d += `Q${x} ${y} ${((x + nx) / 2).toFixed(1)} ${((y + ny) / 2).toFixed(1)}`;
  }
  const [lx, ly] = pts[pts.length - 1];
  return `${d}L${lx} ${ly}`;
};
const lengthOf = (pts: Point[]) =>
  pts.slice(1).reduce((sum, [x, y], i) => sum + Math.hypot(x - pts[i][0], y - pts[i][1]), 0);
let startAt = 0.4;
const doodlePaths = (doodles.strokes as { ink: string; size: number; points: Point[] }[]).map((stroke) => {
  const duration = Math.min(0.9, Math.max(0.2, lengthOf(stroke.points) / 700));
  const path = { d: toPath(stroke.points), size: stroke.size, ink: stroke.ink, delay: startAt.toFixed(2), duration: duration.toFixed(2) };
  startAt += duration * 0.85;
  return path;
});

const selected = (await getWork()).filter((entry) => !entry.data.draft).slice(0, 3);
const hasArt = (await getSection('art')).length > 0;

const contacts = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/ykabusalah' },
  { label: 'Resume', href: 'https://drive.google.com/file/d/1NR0OQ7JmCCDILqD_LLEoXZ_U8wOutDvT/view?usp=sharing' },
  { label: 'Email', href: 'mailto:hello@ykabusalah.me' },
  { label: 'GitHub', href: 'https://github.com/ykabusalah' },
];

---

<PageLayout title="About | Yousef's Personal Website" page="about">
  <header class="hero">
  <figure class="portrait" style={`--patch-mask: url(${patchMask.src})`}>
    <span class="patch" aria-hidden="true"></span>
    <Image
      src={portrait}
      alt="Yousef in a bucket hat with a camera, on the trail at Volcán de Santa Ana"
      widths={[480, 920]}
      sizes="(min-width: 760px) 460px, 100vw"
      format="webp"
      quality={82}
      loading="eager"
    />
    <svg class="doodles" viewBox={`0 0 ${doodles.width} ${doodles.height}`} aria-hidden="true">
      {doodlePaths.map((p) => (
        <path
          d={p.d}
          class={p.ink === 'accent' ? 'accent' : undefined}
          stroke-width={p.size}
          pathLength="1"
          style={`--delay:${p.delay}s;--duration:${p.duration}s`}
        />
      ))}
    </svg>
  </figure>

  <h1 class="page-title"><span class="mark">About Me</span></h1>

  <ul class="chips contacts">
    {contacts.map(({ label, href }) => (
      <li><a class="chip" href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener">{label}</a></li>
    ))}
  </ul>
  </header>

  <div class="bio">
    <Doodle side="right" top="120px" tilt={4} mobile="inline" name="about-fellowship" note="a globe, plane, or map pin for the 30+ countries" width={104} />
    <Doodle side="left" top="20px" tilt={-4} name="about-work-life" note="a laptop or a tiny compliance robot" width={88} />
    <p>
      Hi! I'm Yousef. I'm a <strong>Product Manager at Bretton AI (formerly Greenlite, YC 2023)</strong>, where I own AI agent products used by enterprise banks for compliance investigations, from PRDs and staged rollouts to the evaluation frameworks that prove they work. Recent work includes a self-serve agent builder and an embedded investigation assistant that cut per-case research time from <strong>~20 minutes to near-instant</strong>.
    </p>
    <p>
      As the longest-ever <a href="https://www.keegantravelingfellowship.org/yousef-abu-salah" target="_blank" rel="noopener">Michael B. Keegan Traveling Fellow</a>, where I served for over four years, I <strong>researched hope among displaced communities across 32+ countries</strong>, leading cross-functional initiatives with prominent nonprofits and international organizations such as the <strong>United Nations</strong>.
    </p>
    <p>
      I hold a <strong>B.S. in Computer Science and Cognitive Science</strong> from <strong>Vanderbilt University</strong>, and I am always excited about the endless possibilities that technology has to improve the world and make it a more equitable place.
    </p>
  </div>

  <section class="block">
    <Doodle side="left" top="0px" tilt={-8} name="about-selected-work" note="a small arrow or pointing hand" width={80} />
    <h2 class="section-title">Selected work</h2>
    <ul class="cards">
      {selected.map((entry) => (
        <li>
          <a class="card" href={hrefFor(entry)}>
            <span class="eyebrow">{KIND_LABEL[entry.data.kind]}</span>
            <span class="card-title">{entry.data.title}</span>
            <span class="card-summary">{entry.data.summary}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="more">
      <a href={SECTIONS.projects.path}>All projects →</a>
      {hasArt && <a href={SECTIONS.art.path}>All art →</a>}
    </p>
    <Doodle side="right" top="45%" tilt={6} mobile="inline" name="about-sign-off" note="a sign-off, like you waving" width={104} />
  </section>
</PageLayout>

<style>
  .portrait {
    position: relative;
    width: min(100%, 460px);
    margin: 0 0 -56px;
  }

  /* Side drawings anchor to the section they sit beside, starting below the portrait. */
  .bio,
  .block { position: relative; }

  .portrait :global(img) {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
  }

  /* The splash of color: the portrait's silhouette, slightly out of register like a riso print. */
  .patch {
    position: absolute;
    inset: 0;
    background: var(--accent);
    -webkit-mask: var(--patch-mask) center / 100% 100% no-repeat;
    mask: var(--patch-mask) center / 100% 100% no-repeat;
    transform: translate(3.5%, 3%);
  }

  .doodles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .doodles path {
    fill: none;
    stroke: var(--ink);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 2;
    animation: draw-on var(--duration) ease-out var(--delay) both;
  }

  .doodles path.accent { stroke: var(--accent); }

  /* Hidden (and cap-free) until its turn, then the stroke draws itself along its own path. */
  @keyframes draw-on {
    0% { stroke-dashoffset: 1; opacity: 0; }
    1% { opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .doodles path { animation: none; stroke-dashoffset: 0; }
  }

  /* The title sits over the faded bottom of the photo. */
  .portrait + .page-title { position: relative; }

  .contacts { margin-bottom: 32px; }

  .bio p {
    font-size: 17px;
    line-height: 1.7;
    margin: 0 0 18px;
  }

  .bio strong { font-weight: 600; }

  .bio a {
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .block { margin-top: 56px; }

  .cards {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 12px;
  }

  .card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .card:hover { border-color: var(--ink); }

  .card .eyebrow { margin: 0; }

  .card-title {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.15;
  }

  .card-summary {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .more {
    display: flex;
    gap: 20px;
    margin: 0;
    font-size: 15px;
  }

  .more a { text-underline-offset: 3px; }
</style>
