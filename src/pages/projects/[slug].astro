---
import { render } from 'astro:content';
import '../../styles/prose.css';
import PageLayout from '../../layouts/PageLayout.astro';
import Doodle from '../../components/Doodle.astro';
import { getSection, KIND_LABEL, type WorkEntry } from '../../lib/work';

export async function getStaticPaths() {
  const projects = await getSection('projects');
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: WorkEntry };
const { data } = entry;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());

const links = [
  data.live && { label: data.live.startsWith('/') ? 'Try it' : 'Live site', href: data.live },
  data.github && { label: 'GitHub', href: data.github },
].filter(Boolean) as { label: string; href: string }[];
---

<PageLayout title={`${data.title} | Yousef's Personal Website`} description={data.summary} page={`projects/${entry.id}`}>
  <a class="back" href="/projects">← All projects</a>

  <p class="eyebrow">
    {KIND_LABEL[data.kind]}{data.status === 'in-progress' && ' · In progress'}{data.draft && ' · Draft'}
  </p>
  <h1 class="page-title"><span class="mark">{data.title}</span></h1>
  <p class="summary">{data.summary}</p>

  {links.length > 0 && (
    <ul class="chips links">
      {links.map(({ label, href }) => (
        <li><a class="chip" href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener">{label}</a></li>
      ))}
    </ul>
  )}

  {data.stack.length > 0 && (
    <ul class="chips stack" aria-label="Built with">
      {data.stack.map((item) => <li><span class="chip">{item}</span></li>)}
    </ul>
  )}

  <div class="hero-image"><Doodle kind="image" name={`project-${entry.id}`} note="a screenshot of it" width={680} /></div>

  {hasBody && (
    <div class="body">
      <Doodle side="left" top="40px" tilt={-5} name="project-side" note="a sketch of how it works" width={96} />
      <article class="prose">
        <Content />
      </article>
    </div>
  )}
</PageLayout>

<style>
  .back {
    display: inline-block;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 28px;
  }

  .back:hover { color: var(--ink); }

  .summary {
    font-size: 19px;
    line-height: 1.55;
    margin: 0 0 24px;
  }

  .links { margin-bottom: 12px; }

  .stack .chip {
    font-size: 12px;
    color: var(--muted);
    background: #f7f6f2;
    border-color: transparent;
  }

  .hero-image:not(:empty) {
    margin-top: 32px;
    border-radius: 12px;
    overflow: hidden;
  }

  .hero-image :global(img) { width: 100%; height: auto; }

  .body {
    position: relative;
    margin-top: 48px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
  }
</style>
