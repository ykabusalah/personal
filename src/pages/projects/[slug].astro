---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import '../../styles/prose.css';
import PageLayout from '../../layouts/PageLayout.astro';
import Doodle from '../../components/Doodle.astro';
import DrawingStats from '../../components/DrawingStats.astro';
import ZoomImages from '../../components/ZoomImages.astro';
import { getSection, KIND_LABEL, type WorkEntry } from '../../lib/work';
import { scatter, spotsFor } from '../../data/doodle-spots.js';

export async function getStaticPaths() {
  const projects = await getSection('projects');
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: WorkEntry };
const { data } = entry;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
// This project's doodles (see src/data/doodle-spots.js), spread down both sides of the write-up.
const doodles = scatter(spotsFor(`project:${entry.id}`), 'left');

const links = [
  data.live && { label: data.live.startsWith('/') ? 'Try it' : 'Live site', href: data.live },
  data.github && { label: 'GitHub', href: data.github },
].filter(Boolean) as { label: string; href: string }[];

const glance = [
  ['Role', data.role],
  ['Timeline', data.timeline],
  ['Outcome', data.outcome],
  ['Built with', data.stack.join(', ')],
].filter(([, value]) => value) as [string, string][];
---

<PageLayout title={`${data.title} | Yousef's Personal Website`} description={data.summary} page={`projects/${entry.id}`}>
  <a class="back" href="/projects">← All projects</a>

  <p class="eyebrow">
    {KIND_LABEL[data.kind]}{data.status === 'in-progress' && ' · In progress'}{data.draft && ' · Draft'}
  </p>
  <h1 class="page-title"><span class="mark">{data.title}</span></h1>
  <p class="summary">{data.summary}</p>

  {links.length > 0 && (
    <ul class="chips links">
      {links.map(({ label, href }) => (
        <li><a class="chip" href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener">{label}</a></li>
      ))}
    </ul>
  )}

  {glance.length > 0 && (
    <dl class="glance" aria-label="At a glance">
      {glance.map(([label, value]) => (
        <div class="row">
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  )}

  <div class="hero-image" data-zoomable>
    {data.cover
      ? <Image src={data.cover} alt={data.coverAlt} widths={[680, 1360]} sizes="(min-width: 720px) 680px, 100vw" loading="eager" data-tall={data.cover.height > data.cover.width ? '' : undefined} />
      : <Doodle kind="image" name={`project-${entry.id}`} note="a screenshot of it" width={680} />}
  </div>

  {entry.id === 'drawing-canvas' && <DrawingStats />}

  {hasBody && (
    <div class="body" data-zoomable>
      {doodles.map((d) => <Doodle spot={d.id} side={d.side} top={d.top} tilt={d.tilt} lane={d.lane} width={d.width} />)}
      <article class="prose">
        <Content />
      </article>
    </div>
  )}
  <ZoomImages />
</PageLayout>

<style>
  .back {
    display: inline-block;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 28px;
  }

  .back:hover { color: var(--ink); }

  .summary {
    font-size: 19px;
    line-height: 1.55;
    margin: 0 0 24px;
  }

  .links { margin-bottom: 28px; }

  /* At a glance: label on the left, detail on the right, stacked on phones. */
  .glance {
    margin: 0;
    border-top: 1px solid var(--line);
    font-size: 15px;
  }

  .row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }

  .row dt {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 3px;
  }

  .row dd { margin: 0; }

  @media (max-width: 520px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }

  .hero-image:not(:empty) { margin-top: 32px; }

  .hero-image :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  /* A tall phone screenshot fits on screen, like the ones in the write-up below. */
  .hero-image :global(img[data-tall]) {
    width: auto;
    max-width: 100%;
    height: min(80vh, 720px);
    object-fit: contain;
  }

  .body {
    position: relative;
    margin-top: 48px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
  }
</style>
