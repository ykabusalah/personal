---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Doodle from '../../components/Doodle.astro';
import { getSection } from '../../lib/work';

// Technical work: a structured, scannable list with the stack front and center.
const projects = await getSection('projects');
---

<PageLayout title="Projects | Yousef's Personal Website" page="projects">
  <h1 class="page-title"><span class="mark">Projects</span></h1>

  <section class="list">
    <Doodle side="left" top="20px" tilt={-6} name="projects-side-1" note="a laptop, gear, or blueprint" width={96} />
    <Doodle side="right" top="55%" tilt={5} mobile="inline" name="projects-side-2" note="a little robot or wrench" width={96} />
    <Doodle side="left" top="calc(100% - 130px)" tilt={-4} name="projects-side-3" note="a coffee cup, sticky note, or rubber duck" width={96} />
    <ul class="rows">
      {projects.map((entry) => (
        <li>
          <a class="row" href={`/projects/${entry.id}`}>
            <span class="thumb">
              {entry.data.cover
                ? <Image src={entry.data.cover} alt="" widths={[132, 264]} sizes="132px" />
                : <Doodle kind="image" name={`project-${entry.id}`} note="a screenshot of it" width={132} />}
            </span>
            <span class="text">
              <span class="title-line">
                <span class="title">{entry.data.title}</span>
                {entry.data.draft && <span class="badge">Draft</span>}
                {!entry.data.draft && entry.data.status === 'in-progress' && <span class="badge">In progress</span>}
              </span>
              <span class="summary">{entry.data.summary}</span>
              {entry.data.timeline && <span class="meta">{entry.data.timeline}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</PageLayout>

<style>
  .list { position: relative; margin-top: 32px; }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .row {
    display: flex;
    align-items: flex-start;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  /* Projects with an image get a thumbnail column; the rest keep the full width. */
  .thumb:not(:empty) {
    flex: none;
    width: 132px;
    margin-right: 18px;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }

  .thumb :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .title-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .title {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1.1;
  }

  .row:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  .summary {
    font-size: 15px;
    color: var(--muted);
    max-width: 60ch;
  }

  .meta {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .badge {
    flex: none;
    font-size: 12px;
    padding: 3px 10px;
    border-radius: 999px;
    background: #f1efe9;
    color: var(--muted);
  }

  @media (max-width: 520px) {
    .thumb:not(:empty) { width: 96px; margin-right: 14px; }
    .title { font-size: 24px; }
  }
</style>
