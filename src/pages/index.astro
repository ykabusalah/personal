---
import Base from '../layouts/Base.astro';
import DrawingBackground from '../components/DrawingBackground.astro';

// The drawing app still lives on its own subdomain until it's ported into this project.
const DRAW_URL = 'https://draw.ykabusalah.me/info';
---

<Base>
  <DrawingBackground />

  <main class="home">
    <section class="card">
      <h1>👨🏾‍💻 Hi! I'm Yousef.</h1>
      <p class="tagline">
        AI Product Manager building agent systems for enterprise compliance and <strong>telling stories that technology alone can't</strong>.
      </p>
      <p class="explain">The drawing behind this was made by a visitor.</p>
      <a class="cta" href={DRAW_URL}>
        <svg class="pencil" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20h9" />
          <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4Z" />
        </svg>
        Draw yours
      </a>
    </section>
  </main>

  <footer class="home-footer">
    <span class="credit" data-drawing-credit hidden></span>
  </footer>
</Base>

<style>
  .home {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 96px 16px;
  }

  .card {
    width: min(100%, 560px);
    padding: clamp(24px, 5vw, 44px);
    background: var(--glass);
    backdrop-filter: blur(14px) saturate(1.05);
    -webkit-backdrop-filter: blur(14px) saturate(1.05);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 18px;
    box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.35);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(38px, 7vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 16px;
    text-wrap: balance;
  }

  .tagline {
    font-size: clamp(16px, 2.2vw, 18px);
    margin: 0 0 22px;
    max-width: 44ch;
  }

  .tagline strong { font-weight: 600; }

  .explain {
    font-size: 14px;
    font-style: italic;
    color: var(--muted);
    margin: 0 0 12px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    background: var(--ink);
    color: #fff;
    border-radius: 8px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .cta:hover { background: #333; }

  .pencil { transition: transform 0.2s ease; }
  .cta:hover .pencil { transform: rotate(-12deg); }

  .home-footer {
    position: fixed;
    left: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 1;
  }

  .credit {
    display: inline-block;
    font-size: 12px;
    color: var(--muted);
    padding: 6px 12px;
    background: var(--glass);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 999px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta, .pencil { transition: none; }
  }
</style>
