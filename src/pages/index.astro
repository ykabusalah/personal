---
import Base from '../layouts/Base.astro';
import VisitorDrawing from '../components/VisitorDrawing.astro';
---

<Base>
  <main class="home">
    <div class="art">
      <VisitorDrawing />
    </div>

    <section class="sticker" id="home-sticker" aria-labelledby="home-title">
      <button type="button" class="scoot" data-hide-sticker aria-controls="home-sticker">Sorry, I'm in the way</button>
      <h1 id="home-title">👨🏾‍💻 Hi! I'm Yousef.</h1>
      <p class="tagline">
        AI Product Manager building agent systems for enterprise compliance and <strong>telling stories that technology alone can't</strong>.
      </p>
      <p class="explain">A visitor drew this by hand. All art on this site is human-made. Yours could be next.</p>
      <div class="actions">
        <a class="cta" href="/info">
          <svg class="pencil" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4Z" />
          </svg>
          Draw yours
        </a>
        <a class="email" href="mailto:hello@ykabusalah.me">hello@ykabusalah.me</a>
      </div>
    </section>

    <button type="button" class="bring-back" data-show-sticker aria-controls="home-sticker" hidden>👋 Okay, bring me back</button>
  </main>
</Base>

<script>
  import { trackPageView, trackDrawLinkClick } from '../lib/analytics.js';

  // The stats funnel counts Home -> draw click -> Info, so every link to /info on Home counts as a draw click.
  trackPageView('home');
  document.querySelectorAll('a[href="/info"]').forEach((link) => {
    link.addEventListener('click', () => trackDrawLinkClick());
  });

  // Let visitors move the intro sticker aside to see the whole drawing, and bring it back.
  const sticker = document.getElementById('home-sticker');
  const hideButton = document.querySelector<HTMLButtonElement>('[data-hide-sticker]');
  const showButton = document.querySelector<HTMLButtonElement>('[data-show-sticker]');
  if (sticker && hideButton && showButton) {
    // The animations are only decoration: a timer hides the sticker outright, and it comes back in
    // place right away, so both still work when the browser skips or pauses animations.
    let goneTimer: number | undefined;
    const setAway = (away: boolean) => {
      clearTimeout(goneTimer);
      sticker.classList.remove('is-gone', 'is-back');
      sticker.classList.toggle('is-away', away);
      if (away) goneTimer = window.setTimeout(() => sticker.classList.add('is-gone'), 550);
      else sticker.classList.add('is-back');
      sticker.inert = away;
      showButton.hidden = !away;
      // Without preventScroll the browser scrolls the page to the button and shifts the drawing.
      (away ? showButton : hideButton).focus({ preventScroll: true });
    };
    hideButton.addEventListener('click', () => setAway(true));
    showButton.addEventListener('click', () => setAway(false));
  }
</script>

<style>
  /* Phone: the drawing fills the space under the header; the intro sits below it on a color sticker. */
  .home {
    min-height: 100dvh;
    display: grid;
    grid-template-rows: minmax(36vh, 1fr) auto;
    gap: 28px;
    padding: calc(var(--gutter) + 104px) var(--gutter) var(--gutter);
    overflow: hidden;
  }

  .art {
    position: relative;
    min-height: 0;
    container-type: size;
  }

  .art :global(.visitor-drawing) { position: absolute; inset: 0; }
  .art :global(.stack) { width: min(100cqw, calc(100cqh * var(--ratio))); }
  .art :global(.credit) { right: 0; bottom: -6px; }

  .sticker {
    position: relative;
    z-index: 2;
    padding: 24px 22px 26px;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 22px 12px 26px 14px / 14px 24px 12px 22px;
    transform: rotate(-1.2deg);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(36px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 12px;
    text-wrap: balance;
  }

  .tagline {
    font-size: clamp(15px, 1.25vw, 17px);
    margin: 0 0 18px;
    max-width: 42ch;
  }

  .tagline strong { font-weight: 600; }

  .explain {
    font-size: 13px;
    font-style: italic;
    opacity: 0.8;
    margin: 0 0 12px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-radius: 8px;
    background: var(--on-accent);
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .cta:hover { opacity: 0.88; }

  .pencil { transition: transform 0.2s ease; }
  .cta:hover .pencil { transform: rotate(-12deg); }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
  }

  .email {
    color: inherit;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }

  .email:hover { text-decoration-thickness: 3px; }

  /* Wide screens: the drawing is the whole page; the sticker is tucked into the bottom-left corner. */
  @media (min-width: 860px) {
    .home {
      display: block;
      position: relative;
      height: 100dvh;
      min-height: 560px;
      padding: 0;
    }

    .art { position: absolute; inset: 0; }
    .art :global(.stack) { width: min(104cqw, calc(104cqh * var(--ratio))); }
    .art :global(.credit) { right: calc(var(--gutter) + 8px); bottom: calc(var(--gutter) + 8px); }

    .sticker {
      position: absolute;
      left: var(--gutter);
      bottom: var(--gutter);
      width: min(460px, 40vw);
      padding: 30px 32px 32px;
      transform: rotate(-2.2deg);
      transition: transform 0.5s cubic-bezier(0.5, 0, 0.75, 0), opacity 0.35s ease 0.1s;
    }

    /* Tipped off the bottom of the screen so the whole drawing shows. */
    .sticker.is-away {
      transform: translateY(125%) rotate(-14deg);
      opacity: 0;
      pointer-events: none;
    }

    .sticker.is-gone { visibility: hidden; }

    /* Coming back: jump into place, then bounce up from below (movement only). */
    .sticker.is-back {
      transition: none;
      animation: sticker-back 0.4s cubic-bezier(0.2, 0.8, 0.3, 1.25);
    }

    @keyframes sticker-back {
      from { transform: translateY(48px) rotate(-6deg); }
      to { transform: rotate(-2.2deg); }
    }

    /* A small tag sticking out of the sticker's top edge. */
    .scoot {
      display: block;
      position: absolute;
      bottom: calc(100% - 4px);
      right: 22px;
      padding: 6px 12px 7px;
      border: 0;
      border-radius: 8px 8px 0 0;
      background: var(--ink);
      color: #fff;
      font: 500 12px/1 var(--font-body);
      cursor: pointer;
      transform: rotate(1.5deg);
      transform-origin: bottom center;
    }

    .scoot:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .bring-back:not([hidden]) {
      display: block;
      position: absolute;
      left: var(--gutter);
      bottom: var(--gutter);
      z-index: 2;
      padding: 10px 16px;
      border: 0;
      border-radius: 999px;
      background: var(--accent);
      color: var(--on-accent);
      font: 500 14px/1 var(--font-body);
      cursor: pointer;
      transform: rotate(-2deg);
      box-shadow: 0 8px 20px -12px rgba(0, 0, 0, 0.45);
      animation: pop-in 0.3s ease-out;
    }

    /* Movement only, so the button is visible even if the animation never plays. */
    @keyframes pop-in {
      from { transform: rotate(-2deg) translateY(16px); }
      to { transform: rotate(-2deg) translateY(0); }
    }
  }

  /* Phones: the sticker sits below the drawing, so there is nothing to move out of the way. */
  @media (max-width: 859px) {
    .scoot,
    .bring-back { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta, .pencil, .sticker { transition: none; }
    .bring-back, .sticker.is-back { animation: none; }
  }
</style>
