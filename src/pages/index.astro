---
import Base from '../layouts/Base.astro';
import VisitorDrawing from '../components/VisitorDrawing.astro';
---

<Base>
  <main class="home">
    <header class="intro">
      <h1>👨🏾‍💻 Hi! I'm Yousef.</h1>
      <p class="tagline">
        AI Product Manager building agent systems for enterprise compliance and <strong>telling stories that technology alone can't</strong>.
      </p>
    </header>

    <div class="art">
      <VisitorDrawing />
    </div>

    <div class="actions">
      <p class="explain">The drawing here was made by a visitor. Yours could be next.</p>
      <a class="cta" href="/info">
        <svg class="pencil" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20h9" />
          <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4Z" />
        </svg>
        Draw yours
      </a>
    </div>
  </main>
</Base>

<script>
  import { trackPageView, trackDrawLinkClick } from '../lib/analytics.js';

  // The stats funnel counts Home -> draw click -> Info, so every link to /info on Home counts as a draw click.
  trackPageView('home');
  document.querySelectorAll('a[href="/info"]').forEach((link) => {
    link.addEventListener('click', () => trackDrawLinkClick());
  });
</script>

<style>
  /* Phone: intro, then the drawing full width, then the invitation. */
  .home {
    min-height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'intro'
      'art'
      'actions';
    gap: 28px;
    padding: calc(var(--gutter) + 84px) var(--gutter) 40px;
  }

  .intro { grid-area: intro; }
  .art { grid-area: art; --drawing-max-h: 55vh; }
  .actions { grid-area: actions; }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(38px, 5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 16px;
    text-wrap: balance;
  }

  .tagline {
    font-size: clamp(16px, 1.4vw, 18px);
    margin: 0;
    max-width: 40ch;
  }

  .tagline strong { font-weight: 600; }

  .explain {
    font-size: 14px;
    font-style: italic;
    color: var(--muted);
    margin: 0 0 12px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    background: var(--ink);
    color: #fff;
    border-radius: 8px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .cta:hover { background: #333; }

  .pencil { transition: transform 0.2s ease; }
  .cta:hover .pencil { transform: rotate(-12deg); }

  /* Wide screens: text column on the left, the drawing takes everything else. */
  @media (min-width: 860px) {
    .home {
      grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas:
        '.       art'
        'intro   art'
        'actions art'
        '.       art';
      column-gap: clamp(32px, 5vw, 88px);
      row-gap: 0;
      padding: var(--gutter);
    }

    .actions { margin-top: 28px; }

    /* Top padding keeps tall drawings clear of the nav links. */
    .art {
      --drawing-max-h: calc(100dvh - 2 * var(--gutter) - 144px);
      align-self: stretch;
      padding-top: 72px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta, .pencil { transition: none; }
  }
</style>
