---
import '../styles/tokens.css';
import '../styles/app.css';
import Head from '../components/Head.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  noindex?: boolean;
  /** Show the site logo and nav. Off for full-screen tools like the canvas and admin pages. */
  header?: boolean;
}

const { title, noindex, header = false } = Astro.props;
---

<!doctype html>
<!-- Always light: people draw black on white, and the admin pages were built for light. -->
<html lang="en" data-light-only>
  <head>
    <Head title={title} noindex={noindex} />
  </head>
  <body>
    {header && <SiteHeader />}
    <slot />
  </body>
</html>
