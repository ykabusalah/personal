---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  /** Page name recorded in analytics page_view events. */
  page: string;
}

const { title, description, page } = Astro.props;
---

<Base title={title} description={description}>
  <main class="page" data-track-page={page}>
    <slot />
  </main>
  <footer class="page-footer">
    <p class="copyright">© {new Date().getFullYear()} Yousef Abu-Salah. My art is mine, so please ask before using it anywhere.</p>
  </footer>
</Base>

<script>
  import { trackPageView } from '../lib/events.js';

  const page = document.querySelector('[data-track-page]')?.getAttribute('data-track-page');
  if (page) trackPageView(page);
</script>

<style>
  .page,
  .page-footer {
    max-width: calc(680px + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .page { padding-top: calc(var(--gutter) + 96px); }

  .page-footer { padding-block: 72px 40px; }

  .copyright {
    margin: 0;
    padding-top: 18px;
    border-top: 1px dashed var(--line);
    font-size: 13px;
    color: var(--muted);
  }
</style>
