---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  /** Page name recorded in analytics page_view events. */
  page: string;
}

const { title, description, page } = Astro.props;
---

<Base title={title} description={description}>
  <main class="page" data-track-page={page}>
    <slot />
  </main>
</Base>

<script>
  import { trackPageView } from '../lib/analytics.js';

  const page = document.querySelector('[data-track-page]')?.getAttribute('data-track-page');
  if (page) trackPageView(page);
</script>

<style>
  .page {
    max-width: calc(680px + 2 * var(--gutter));
    margin: 0 auto;
    padding: calc(var(--gutter) + 96px) var(--gutter) 72px;
  }
</style>
