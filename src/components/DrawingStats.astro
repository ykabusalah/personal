---
// Live totals for the drawing site, shown on its project page. No totals means no box,
// rather than numbers that could be wrong.
import { approvalRate, fetchDrawingTotals, formatCount } from '../lib/drawing-totals';

const stats = await fetchDrawingTotals();
---

{stats && (
  <section class="numbers" aria-labelledby="numbers-title" data-drawing-stats>
    <h2 id="numbers-title" class="section-title"><span class="live" aria-hidden="true"></span>By the numbers</h2>
    <dl class="tiles">
      <div class="tile">
        <dt>Visitors</dt>
        <dd data-stat="visitors">{formatCount(stats.visitors)}</dd>
      </div>
      <div class="tile">
        <dt>Drawings submitted</dt>
        <dd data-stat="submitted">{formatCount(stats.submitted)}</dd>
      </div>
      <div class="tile">
        <dt>Made the cut</dt>
        <dd data-stat="approved">{formatCount(stats.approved)}</dd>
      </div>
      <div class="tile">
        <dt>Approval rate</dt>
        <dd data-stat="rate">{approvalRate(stats)}%</dd>
      </div>
    </dl>
    <p class="note">Live from the site's database. I review every single drawing by hand, so if you're wondering about that approval rate, yes, blame me.</p>
  </section>
)}

<script>
  import { approvalRate, formatCount, watchDrawingTotals } from '../lib/drawing-totals';
  import { showNumber } from '../lib/ticker';

  // The numbers above are from the last build; swap in today's, and keep them current while the
  // page is open, animating each change.
  const box = document.querySelector('[data-drawing-stats]');
  if (box) {
    watchDrawingTotals((t, first) => {
      const set = (key: string, value: string) => showNumber(box.querySelector(`[data-stat="${key}"]`), value, !first);
      set('visitors', formatCount(t.visitors));
      set('submitted', formatCount(t.submitted));
      set('approved', formatCount(t.approved));
      set('rate', `${approvalRate(t)}%`);
    });
  }
</script>

<style>
  .numbers { margin: 44px 0 8px; }

  .section-title {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .live {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    50% { opacity: 0.35; }
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    margin: 0;
  }

  .tile {
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  dt {
    font-size: 13px;
    color: var(--muted);
  }

  dd {
    margin: 6px 0 0;
    font-family: var(--font-display);
    font-size: 40px;
    line-height: 1;
  }

  .note {
    margin: 14px 0 0;
    font-size: 14px;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .live { animation: none; }
  }
</style>
