---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { seasonalIcon } from '../lib/seasonal';

// The source drawings are 2000px; ship small webp copies instead.
const sources = import.meta.glob<{ default: ImageMetadata }>('../assets/seasonal/*.png', { eager: true });
const urls: Record<string, string> = {};
for (const [path, mod] of Object.entries(sources)) {
  const optimized = await getImage({ src: mod.default, width: 480, format: 'webp' });
  urls[path.split('/').pop()!] = optimized.src;
}

// Build-time pick so the page never flashes empty; the script below re-picks by the visitor's own date.
const initial = urls[seasonalIcon()];
---

<a href="/" class="seasonal-logo" aria-label="Home" data-seasonal-urls={JSON.stringify(urls)}>
  <img src={initial} alt="" width="480" height="504" />
</a>

<script>
  import { seasonalIcon } from '../lib/seasonal';

  const link = document.querySelector<HTMLAnchorElement>('[data-seasonal-urls]');
  if (link) {
    const urls: Record<string, string> = JSON.parse(link.dataset.seasonalUrls || '{}');
    const img = link.querySelector('img');
    const current = urls[seasonalIcon()];
    if (img && current && !img.src.endsWith(current)) img.src = current;

    // On Home, clicking the head reloads the page for a new visitor drawing.
    link.addEventListener('click', (event) => {
      if (window.location.pathname === '/') {
        event.preventDefault();
        window.location.reload();
      }
    });
  }
</script>

<style>
  .seasonal-logo {
    position: fixed;
    top: calc(var(--gutter) - 8px + env(safe-area-inset-top, 0px));
    left: calc(var(--gutter) - 8px);
    z-index: 30;
    display: block;
    width: clamp(72px, 8vw, 104px);
    aspect-ratio: 0.85;
    transform-origin: top left;
  }

  /* Every head drawing shares the same framing, so one zoom centers the head in all of them.
     The art has a transparent background, so nothing is clipped and hover growth never cuts the head off. */
  .seasonal-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    transform: scale(2.14);
    transform-origin: 49% 52%;
    transition: transform 0.2s ease;
  }

  .seasonal-logo:hover img { transform: scale(2.24); }

  /* Shrink a little once the page scrolls so the fixed head stays out of the way (where supported). */
  @supports (animation-timeline: scroll()) {
    .seasonal-logo {
      animation: head-shrink linear both;
      animation-timeline: scroll(root);
      animation-range: 0 240px;
    }

    @keyframes head-shrink {
      to { transform: scale(0.72); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .seasonal-logo img { transition: none; }
  }
</style>
