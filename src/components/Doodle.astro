---
import { Image } from 'astro:assets';
import { doodle, mockDoodle } from '../lib/art';
import { spotById } from '../data/doodle-spots.js';

interface Props {
  /** A doodle spot's id from src/data/doodle-spots.js, like "1a". Its drawing is src/art/doodles/1a.png. */
  spot?: string;
  /** For image spots: the file name (without extension) in src/art/ that fills it. */
  name?: string;
  /** For image spots: what goes there; shown on the placeholder. */
  note?: string;
  width?: number;
  /** Use 'image' for photo or screenshot spots instead of small drawings. */
  kind?: 'doodle' | 'image';
  aspect?: string;
  /** Place the drawing in the empty white space beside the content column (wide screens only). */
  side?: 'left' | 'right';
  /** Offset from the top of the nearest positioned section, e.g. "40px" or "30%". */
  top?: string;
  /** Slight tilt in degrees, for a hand-placed feel. */
  tilt?: number;
  /** How far out a side drawing sits: 0 hugs the text, 1 is out near the screen edge. */
  lane?: number;
  /** Phones have no side space: 'hide' drops a side drawing there, 'inline' shows it smaller between sections. */
  mobile?: 'hide' | 'inline';
}

const {
  spot,
  kind = 'doodle',
  aspect = kind === 'image' ? '16 / 10' : '1',
  side,
  top = '0px',
  tilt = 0,
  lane = 0,
  mobile = 'hide',
} = Astro.props;

const found = spot ? spotById(spot) : undefined;
if (spot && !found) throw new Error(`There's no doodle spot "${spot}" in src/data/doodle-spots.js.`);
const name = found?.id ?? Astro.props.name ?? '';
const note = found?.idea ?? Astro.props.note ?? '';
const width = Astro.props.width ?? found?.width ?? 88;

// Test: while trying out the draw-in effect, every doodle spot without its own drawing can show
// this one instead, e.g. 'doodle1'. null shows each spot's placeholder while developing.
const TEST_DOODLE: string | null = null;

// Stand-ins from `npm run doodles:mock` fill empty spots, but only while developing: the live
// site shows real, hand-drawn doodles and nothing else. `npm run doodles:unmock` removes them.
const standIn = import.meta.env.DEV && kind === 'doodle' ? await mockDoodle(name) : undefined;

const match = (await doodle(name)) ?? standIn ?? (kind === 'doodle' && TEST_DOODLE ? await doodle(TEST_DOODLE) : undefined);

// Empty spots only show while developing, so a placeholder can never ship to the live site.
const showPlaceholder = !match && import.meta.env.DEV;
---

{(match || showPlaceholder) && (
  <span class:list={['holder', side && `side ${side}`, side && mobile === 'inline' && 'inline']} style={`--top:${top};--tilt:${tilt}deg;--lane:${lane};--dw:${width}px`}>
    {match && <Image class="doodle art-image" src={match} width={Math.min(width * 2, match.width)} widths={[width, width * 2]} sizes={`${width}px`} style={`--w:${width}px`} alt="" aria-hidden="true" draggable="false" />}
    {showPlaceholder && (
      <span class:list={['slot', kind]} style={`--w:${width}px;--aspect:${aspect}`} title={`${name}: ${note}`} aria-hidden="true">
        {kind === 'image'
          ? <><strong>image</strong><span>{name}</span></>
          : <strong class="id">{name}</strong>}
        <em>{note}</em>
      </span>
    )}
  </span>
)}

<script>
  import { drawIn } from '../lib/draw-in';

  // Each doodle draws itself in the first time it scrolls into view. The page head hides doodles
  // until this script is ready (see Head.astro), so they never flash in already drawn.
  const root = document.documentElement;
  root.dataset.doodles = 'ready';

  const reveal = (img: HTMLImageElement) => img.classList.add('is-drawn');

  async function drawDoodle(img: HTMLImageElement) {
    // Draw on a canvas that takes the image's exact place, then swap the image back.
    const canvas = document.createElement('canvas');
    let over = false;
    const draw = async () => {
      await img.decode();
      const w = img.offsetWidth;
      const h = img.offsetHeight;
      if (over || !w || !h) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const full = document.createElement('canvas');
      full.width = Math.round(w * dpr);
      full.height = Math.round(h * dpr);
      full.getContext('2d')!.drawImage(img, 0, 0, full.width, full.height);
      canvas.className = img.className;
      canvas.style.cssText = `${img.style.cssText};width:${w}px;height:${h}px`;
      canvas.setAttribute('aria-hidden', 'true');
      img.before(canvas);
      img.style.display = 'none';
      await drawIn(canvas, full, { duration: 1100, maxPixels: 400_000 });
    };
    // If the browser pauses (a background tab, or an app's preview panel), show the finished doodle anyway.
    const gaveUp = new Promise((resolve) => setTimeout(resolve, 3000));
    await Promise.race([draw(), gaveUp]).catch(() => {});
    over = true;
    canvas.remove();
    img.style.display = '';
    reveal(img);
  }

  const doodles = [...document.querySelectorAll<HTMLImageElement>('img.doodle')];
  if (!root.classList.contains('doodles-pending') || !('IntersectionObserver' in window)) {
    doodles.forEach(reveal);
  } else {
    const started = new Set<Element>();
    const start = (img: HTMLImageElement) => {
      if (started.has(img)) return;
      started.add(img);
      watcher.unobserve(img);
      drawDoodle(img);
    };
    const watcher = new IntersectionObserver(
      (entries) => entries.forEach((entry) => entry.isIntersecting && start(entry.target as HTMLImageElement)),
      { threshold: 0.3 },
    );
    doodles.forEach((img) => watcher.observe(img));

    // Backstop in case the watcher never reports (some browsers pause it): anything already on
    // screen gets drawn after a moment, and again whenever the tab comes back into view.
    const sweep = () => {
      for (const img of doodles) {
        const r = img.getBoundingClientRect();
        if (r.bottom > 0 && r.top < innerHeight && r.right > 0 && r.left < innerWidth) start(img);
      }
    };
    setTimeout(sweep, 1500);
    document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && sweep());
  }
</script>

<style>
  .holder { display: contents; }

  /* Hidden until they draw themselves in (the page head adds doodles-pending). */
  :global(:root.doodles-pending) .holder :global(img.doodle:not(.is-drawn)) { visibility: hidden; }

  /* Side doodles sit in the white space beside the column and only appear when there is room for them. */
  /* max-content: out in the margin there's no room left over, so without it the drawing shrinks to nothing. */
  .side {
    display: none;
    position: absolute;
    width: max-content;
    top: var(--top);
    transform: rotate(var(--tilt));
    pointer-events: none;
  }

  /* --room is the white space left between the drawing and the screen edge; --lane picks how much
     of it to use, so drawings don't all line up in one straight column. */
  .side {
    --gap: clamp(32px, 6vw, 96px);
    --room: max(0px, (100vw - 100%) / 2 - var(--gap) - var(--dw) - 40px);
  }

  .side.left { right: calc(100% + var(--gap) + var(--lane) * var(--room)); }
  .side.right { left: calc(100% + var(--gap) + var(--lane) * var(--room)); }

  @media (min-width: 1100px) {
    .side { display: block; }
  }

  /* Narrow screens: chosen side drawings drop into the flow, smaller, still hugging their side. */
  @media (max-width: 1099px) {
    .side.inline {
      display: flex;
      position: static;
      width: auto;
      justify-content: flex-start;
      margin: 4px 0 16px;
      transform: rotate(var(--tilt)) scale(0.8);
      transform-origin: left center;
    }

    .side.inline.right {
      justify-content: flex-end;
      transform-origin: right center;
    }
  }

  /* The drawing, or the canvas it draws itself in on (not the placeholder, which shares the class). */
  .holder :global(img.doodle),
  .holder :global(canvas.doodle) {
    display: block;
    width: var(--w, auto);
    height: auto;
  }

  .slot {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    width: var(--w);
    max-width: 100%;
    aspect-ratio: var(--aspect);
    padding: 8px;
    border: 1.5px dashed var(--accent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--muted);
    font: 10px/1.25 var(--font-body);
    text-align: center;
    overflow: hidden;
  }

  .slot strong {
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* The spot's id, big enough to read at a glance when deciding which drawing goes where. */
  .slot strong.id {
    font-size: 22px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
  }

  .slot span { font-family: ui-monospace, Menlo, Consolas, monospace; }
  .slot em { font-style: normal; }
</style>
