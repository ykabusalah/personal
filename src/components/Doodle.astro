---
import { Image } from 'astro:assets';
import { doodle } from '../lib/art';

interface Props {
  /** File name (without extension) in src/art/doodles/ that fills this spot. */
  name: string;
  /** What kind of drawing fits here; shown on the placeholder. */
  note: string;
  width?: number;
  /** Use 'image' for photo or screenshot spots instead of small drawings. */
  kind?: 'doodle' | 'image';
  aspect?: string;
  /** Place the drawing in the empty white space beside the content column (wide screens only). */
  side?: 'left' | 'right';
  /** Offset from the top of the nearest positioned section, e.g. "40px" or "30%". */
  top?: string;
  /** Slight tilt in degrees, for a hand-placed feel. */
  tilt?: number;
  /** Phones have no side space: 'hide' drops a side drawing there, 'inline' shows it smaller between sections. */
  mobile?: 'hide' | 'inline';
}

const {
  name,
  note,
  width = 88,
  kind = 'doodle',
  aspect = kind === 'image' ? '16 / 10' : '1',
  side,
  top = '0px',
  tilt = 0,
  mobile = 'hide',
} = Astro.props;

const match = await doodle(name);

// Empty spots only show while developing, so a placeholder can never ship to the live site.
const showPlaceholder = !match && import.meta.env.DEV;
---

{(match || showPlaceholder) && (
  <span class:list={['holder', side && `side ${side}`, side && mobile === 'inline' && 'inline']} style={`--top:${top};--tilt:${tilt}deg`}>
    {match && <Image class="doodle art-image" src={match} width={Math.min(width * 2, match.width)} widths={[width, width * 2]} sizes={`${width}px`} style={`--w:${width}px`} alt="" aria-hidden="true" draggable="false" />}
    {showPlaceholder && (
      <span class:list={['slot', kind]} style={`--w:${width}px;--aspect:${aspect}`} title={`${name}: ${note}`} aria-hidden="true">
        <strong>{kind === 'image' ? 'image' : 'doodle'}</strong>
        <span>{name}</span>
        <em>{note}</em>
      </span>
    )}
  </span>
)}

<style>
  .holder { display: contents; }

  /* Side doodles sit in the white space beside the column and only appear when there is room for them. */
  .side {
    display: none;
    position: absolute;
    top: var(--top);
    transform: rotate(var(--tilt));
    pointer-events: none;
  }

  .side.left { right: calc(100% + clamp(32px, 6vw, 96px)); }
  .side.right { left: calc(100% + clamp(32px, 6vw, 96px)); }

  @media (min-width: 1100px) {
    .side { display: block; }
  }

  /* Narrow screens: chosen side drawings drop into the flow, smaller, still hugging their side. */
  @media (max-width: 1099px) {
    .side.inline {
      display: flex;
      position: static;
      justify-content: flex-start;
      margin: 4px 0 16px;
      transform: rotate(var(--tilt)) scale(0.8);
      transform-origin: left center;
    }

    .side.inline.right {
      justify-content: flex-end;
      transform-origin: right center;
    }
  }

  .holder :global(.doodle) {
    display: block;
    width: var(--w, auto);
    height: auto;
  }

  /* Chalkboard, like the visitor drawings: black lines flip to white on a dark page, and the
     hue-rotate turns any colors back around so they stay roughly the same. */
  @media (prefers-color-scheme: dark) {
    .holder :global(.doodle) { filter: invert(1) hue-rotate(180deg); }
  }

  .slot {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    width: var(--w);
    max-width: 100%;
    aspect-ratio: var(--aspect);
    padding: 8px;
    border: 1.5px dashed var(--accent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--muted);
    font: 10px/1.25 var(--font-body);
    text-align: center;
    overflow: hidden;
  }

  .slot strong {
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .slot span { font-family: ui-monospace, Menlo, Consolas, monospace; }
  .slot em { font-style: normal; }
</style>
