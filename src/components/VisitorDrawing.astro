<div class="visitor-drawing">
  <div class="stack" data-drawing-stack>
    <canvas data-drawing-canvas role="img" aria-label="A drawing by a site visitor"></canvas>
  </div>
  <p class="credit" data-drawing-credit>
    <svg viewBox="0 0 40 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M38 18 C28 22, 16 16, 4 5" />
      <path d="M4 5 L12 6 M4 5 L6 13" />
    </svg>
    <span data-drawing-artist></span>
  </p>
</div>

<script>
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const HISTORY_KEY = 'recent_drawings';
  const HISTORY_SIZE = 5;
  const DRAW_IN_MS = 1800;
  // Final render resolution cap, and a lighter one for the animation frames so the draw-in stays smooth.
  const MAX_PIXELS = 8_000_000;
  const ANIM_PIXELS = 2_000_000;

  type Drawing = { id: string; name: string | null; image_url: string };
  type Source = { image: CanvasImageSource; ratio: number };

  const stack = document.querySelector<HTMLElement>('[data-drawing-stack]')!;
  const canvas = document.querySelector<HTMLCanvasElement>('[data-drawing-canvas]')!;
  const credit = document.querySelector<HTMLElement>('[data-drawing-credit]')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function readHistory(): string[] {
    try {
      return JSON.parse(sessionStorage.getItem(HISTORY_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function writeHistory(ids: string[]) {
    try {
      sessionStorage.setItem(HISTORY_KEY, JSON.stringify(ids));
    } catch {}
  }

  // onload rather than decode(): Safari can reject decode() for SVG images.
  function loadImage(src: string, crossOrigin = false): Promise<HTMLImageElement> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      if (crossOrigin) img.crossOrigin = 'anonymous';
      img.onload = () => resolve(img);
      img.onerror = () => reject(new Error(`Could not load ${src}`));
      img.src = src;
    });
  }

  // The drawing's box can briefly be 0x0 while the page is still laying out; wait for a real size.
  function waitForSize(): Promise<void> {
    if (stack.clientWidth > 0 && stack.clientHeight > 0) return Promise.resolve();
    return new Promise((resolve) => {
      const observer = new ResizeObserver(() => {
        if (stack.clientWidth > 0 && stack.clientHeight > 0) {
          observer.disconnect();
          resolve();
        }
      });
      observer.observe(stack);
    });
  }

  // Fallback for drawings approved since the last build: crop the original PNG to its ink.
  async function trimmedPng(url: string): Promise<Source> {
    const img = await loadImage(url, true);
    const { naturalWidth: w, naturalHeight: h } = img;
    const full = document.createElement('canvas');
    full.width = w;
    full.height = h;
    const ctx = full.getContext('2d', { willReadFrequently: true })!;
    ctx.drawImage(img, 0, 0);
    const { data } = ctx.getImageData(0, 0, w, h);
    let x0 = w, y0 = h, x1 = -1, y1 = -1;
    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        if (data[(y * w + x) * 4 + 3] > 16) {
          if (x < x0) x0 = x;
          if (x > x1) x1 = x;
          if (y < y0) y0 = y;
          if (y > y1) y1 = y;
        }
      }
    }
    if (x1 < 0) return { image: full, ratio: w / h };
    const pad = 8;
    x0 = Math.max(0, x0 - pad); y0 = Math.max(0, y0 - pad);
    x1 = Math.min(w - 1, x1 + pad); y1 = Math.min(h - 1, y1 + pad);
    const out = document.createElement('canvas');
    out.width = x1 - x0 + 1;
    out.height = y1 - y0 + 1;
    out.getContext('2d')!.drawImage(full, x0, y0, out.width, out.height, 0, 0, out.width, out.height);
    return { image: out, ratio: out.width / out.height };
  }

  // Draw the source at the drawing's on-screen size times the device pixel ratio, so it's never upscaled.
  function rasterize(image: CanvasImageSource) {
    const rect = stack.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 3);
    let w = Math.max(1, Math.round(rect.width * dpr));
    let h = Math.max(1, Math.round(rect.height * dpr));
    if (w * h > MAX_PIXELS) {
      const s = Math.sqrt(MAX_PIXELS / (w * h));
      w = Math.round(w * s);
      h = Math.round(h * s);
    }
    const off = document.createElement('canvas');
    off.width = w;
    off.height = h;
    off.getContext('2d')!.drawImage(image, 0, 0, w, h);
    return off;
  }

  function showFinal(off: HTMLCanvasElement) {
    canvas.width = off.width;
    canvas.height = off.height;
    canvas.getContext('2d')!.drawImage(off, 0, 0);
  }

  function downscale(src: HTMLCanvasElement, maxPixels: number) {
    if (src.width * src.height <= maxPixels) return src;
    const s = Math.sqrt(maxPixels / (src.width * src.height));
    const out = document.createElement('canvas');
    out.width = Math.round(src.width * s);
    out.height = Math.round(src.height * s);
    out.getContext('2d')!.drawImage(src, 0, 0, out.width, out.height);
    return out;
  }

  // Reveal the ink along each connected stroke, outward from where it starts, one shape after another.
  function drawIn(off: HTMLCanvasElement, animate: boolean): Promise<void> {
    if (!animate) {
      showFinal(off);
      return Promise.resolve();
    }
    const anim = downscale(off, ANIM_PIXELS);
    const { width: w, height: h } = anim;
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d')!;
    const src = anim.getContext('2d', { willReadFrequently: true })!.getImageData(0, 0, w, h).data;
    const seen = new Uint8Array(w * h);
    let inkCount = 0;
    for (let i = 0; i < w * h; i++) if (src[i * 4 + 3] > 24) inkCount++;
    const order = new Int32Array(inkCount);
    let n = 0;
    for (let x = 0; x < w; x++) {
      for (let y = 0; y < h; y++) {
        const s = y * w + x;
        if (seen[s] || src[s * 4 + 3] <= 24) continue;
        seen[s] = 1;
        let head = n;
        order[n++] = s;
        while (head < n) {
          const i = order[head++];
          const ix = i % w, iy = (i - ix) / w;
          for (let dy = -1; dy <= 1; dy++) {
            for (let dx = -1; dx <= 1; dx++) {
              const nx = ix + dx, ny = iy + dy;
              if (nx < 0 || ny < 0 || nx >= w || ny >= h) continue;
              const j = ny * w + nx;
              if (!seen[j] && src[j * 4 + 3] > 24) {
                seen[j] = 1;
                order[n++] = j;
              }
            }
          }
        }
      }
    }
    const frame = ctx.createImageData(w, h);
    const px = frame.data;
    let shown = 0;
    const start = performance.now();
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
    return new Promise((resolve) => {
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / DRAW_IN_MS);
        const target = Math.floor(n * ease(t));
        for (let k = shown; k < target; k++) {
          const p = order[k] * 4;
          px[p] = src[p]; px[p + 1] = src[p + 1]; px[p + 2] = src[p + 2]; px[p + 3] = src[p + 3];
        }
        shown = target;
        ctx.putImageData(frame, 0, 0);
        if (t < 1) requestAnimationFrame(step);
        else {
          showFinal(off);
          resolve();
        }
      };
      requestAnimationFrame(step);
    });
  }

  async function show() {
    const [drawings, manifest] = await Promise.all([
      fetch(`${SUPABASE_URL}/rest/v1/drawings?select=id,name,image_url&status=eq.approved`, {
        headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` },
      }).then((r) => (r.ok ? (r.json() as Promise<Drawing[]>) : [])),
      fetch('/drawings/manifest.json')
        .then((r) => (r.ok ? r.json() : { drawings: [] }))
        .catch(() => ({ drawings: [] })),
    ]);
    if (!drawings.length) return;

    // Keep any drawing count on the page in step with the live list, since the built number goes stale.
    document.querySelectorAll<HTMLElement>('[data-drawing-count]').forEach((el) => (el.textContent = String(drawings.length)));
    document.querySelectorAll<HTMLElement>('[data-drawing-count-clause]').forEach((el) => (el.hidden = false));

    // Skip the last few shown this session so refreshes feel fresh.
    const recent = readHistory();
    const fresh = drawings.filter((d) => !recent.includes(d.id));
    const pool = fresh.length ? fresh : drawings;
    const pick = pool[Math.floor(Math.random() * pool.length)];
    writeHistory([pick.id, ...recent].slice(0, Math.min(HISTORY_SIZE, drawings.length - 1)));

    const vector = new Map<string, number>(manifest.drawings.map((d: { id: string; ratio: number }) => [d.id, d.ratio]));
    let source: Source | null = null;
    if (vector.has(pick.id)) {
      try {
        source = { image: await loadImage(`/drawings/${pick.id}.svg`), ratio: vector.get(pick.id)! };
      } catch {
        source = null;
      }
    }
    source ??= await trimmedPng(pick.image_url);
    const image = source.image;

    const artist = pick.name?.trim() || 'an anonymous visitor';
    canvas.setAttribute('aria-label', `A drawing by ${artist}, a site visitor`);
    credit.querySelector('[data-drawing-artist]')!.textContent = `drawn by ${artist}`;

    stack.style.setProperty('--ratio', String(source.ratio));
    await waitForSize();
    await drawIn(rasterize(image), !reduceMotion);
    credit.classList.add('is-shown');

    // Redraw at the new resolution whenever the drawing's box changes size.
    let size = `${stack.clientWidth}x${stack.clientHeight}`;
    let resizeTimer: number | undefined;
    new ResizeObserver(() => {
      const next = `${stack.clientWidth}x${stack.clientHeight}`;
      if (next === size || !stack.clientWidth || !stack.clientHeight) return;
      size = next;
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => drawIn(rasterize(image), false), 150);
    }).observe(stack);
  }

  show().catch(() => {});
</script>

<style>
  .visitor-drawing {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
  }

  .stack {
    --ratio: 1.7;
    aspect-ratio: var(--ratio);
    max-width: 100%;
  }

  .stack canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Chalkboard: visitors draw in black, so in dark mode their lines flip to white. */
  :global(:root[data-theme='dark']) .stack canvas { filter: invert(1); }

  .credit {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-family: var(--font-hand);
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1;
    color: var(--ink);
    white-space: nowrap;
    transform: rotate(-4deg);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .credit svg {
    width: 34px;
    height: 20px;
    flex: none;
  }

  .credit.is-shown { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .credit { transition: none; }
  }
</style>
